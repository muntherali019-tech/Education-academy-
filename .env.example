# Copy to .env.local and fill in to enable the camera features (photo marking
# and scan & solve) in `npm run dev`. The key is read by the dev-server
# endpoints only — it never reaches the browser.
ANTHROPIC_API_KEY=

# Only needed when the endpoints are not served from this origin.
# VITE_MARKING_ENDPOINT=https://example.com/api/mark
# VITE_SOLVE_ENDPOINT=https://example.com/api/solve

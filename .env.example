# Copy this file to ".env" and paste your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Port the backend proxy runs on (Vite proxies /api here in dev)
PORT=8787

# Secret used to sign auth tokens in the built-in dev auth.
# Set a long random value in production (or move auth to a managed provider).
AUTH_SECRET=change-me-to-a-long-random-string

# ---- AI model (optional) ----
# Default model for the /api/claude proxy. The server also lets the client pick
# claude-opus-4-8 (homework marking / scan-and-solve) or claude-haiku-4-5-20251001
# (tiny routing/translation calls) from a fixed allow-list in server/index.js —
# that list is code, not configuration, so add new models there.
# ANTHROPIC_MODEL=claude-sonnet-5

# ---- Server hardening ----
# Set to 1 behind a reverse proxy (Render, Heroku, nginx) so req.ip is the real
# client address. Without it every visitor shares the proxy's IP and one busy
# user's rate limit throttles the whole site. Leave unset when clients connect
# directly — trusting X-Forwarded-For there lets callers spoof their IP.
# TRUST_PROXY=1
# Lock CORS to your own site in production (comma-separated for several origins).
# Leave blank to allow any origin, which is the right default for local dev.
# CORS_ORIGIN=https://your-domain.example

# ---- Premium voice (optional) ----
# Add an ElevenLabs key to enable Mochi's premium cloud voice. Leave blank to
# use the free on-device voice. Pick a child-friendly voice id from your account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Weekly parent emails (optional) ----
# Provider: "console" (default, just logs), "resend", or "sendgrid".
EMAIL_PROVIDER=console
EMAIL_FROM=Education Academy <noreply@your-domain.example>
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# Protect the cron endpoint; send this as the x-cron-secret header.
# CRON_SECRET=
# Set to 1 to run the weekly check inside the server process (no external cron needed).
# WEEKLY_EMAILS_INPROCESS=0
# Secret for the admin endpoints — weekly report (preview/trigger) and the analytics funnel
# (GET /api/admin/funnel). Send it as the x-admin-secret header.
# ADMIN_SECRET=

# ---- Web build payments (Stripe) ----
# Used by the Express server for the WEB build's checkout + billing portal.
# Checkout is created server-side and the browser is redirected to Stripe's hosted
# page, so no publishable key is needed in the frontend.
STRIPE_SECRET_KEY=
STRIPE_PRICE_JUNIOR=
STRIPE_PRICE_ADULT=
# Family plan (Junior + Adult for one household) — recurring price id.
STRIPE_PRICE_FAMILY=
# Annual prices (recurring yearly). The plans screen DEFAULTS to the annual cycle, so
# set all three. If one is missing, annual checkout for that plan is refused rather
# than silently falling back to the monthly price — the UI would have quoted a yearly
# figure while Stripe billed monthly.
STRIPE_PRICE_JUNIOR_YEARLY=
STRIPE_PRICE_ADULT_YEARLY=
STRIPE_PRICE_FAMILY_YEARLY=
# REQUIRED to take payments. The webhook fails closed: with this unset every event
# is rejected, so customers can pay and never be granted access. Get it from
# Stripe > Developers > Webhooks after pointing an endpoint at
# <your-domain>/api/stripe/webhook (events: checkout.session.completed,
# customer.subscription.created/updated/deleted).
STRIPE_WEBHOOK_SECRET=
# How stale a webhook's signed timestamp may be before it's rejected, in seconds.
# Guards against replay of a captured delivery. Default 300.
# STRIPE_WEBHOOK_TOLERANCE=300
# Gift subscriptions (one-time payment prices; leave blank to disable web gifting).
STRIPE_GIFT_PRICE_JUNIOR=
STRIPE_GIFT_PRICE_ADULT=
STRIPE_GIFT_PRICE_FAMILY=
# Where Checkout returns the user (your deployed web URL):
PUBLIC_WEB_URL=http://localhost:5173

# ---------- Durable database (optional) ----------
# Leave blank to use the JSON file store (fine locally and on hosts with a persistent disk).
# Set this to a Postgres connection string to keep accounts across restarts/redeploys on
# ephemeral hosts. Then run: npm install pg
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- Build-time (frontend) variables ----
# Everything below is baked into the browser bundle at build time, so it is PUBLIC.
# Never put a secret in a VITE_ variable. These are usually set via .env.web /
# .env.app / .env.onefile rather than here.

# Where the app finds the backend API. Leave unset in dev (proxies to /api).
# In production set to your deployed API, e.g. https://api.your-domain.example/api
# VITE_API_BASE=

# Which build this is. Normally set by .env.web / .env.app, not by hand.
# VITE_PLATFORM=web|app

# Billing provider. Blank = mock in dev, the real provider in production builds.
# VITE_BILLING=mock|revenuecat|stripe
# RevenueCat public SDK key (required when VITE_BILLING=revenuecat; app build only).
# VITE_REVENUECAT_KEY=goog_xxx

# Voice backend: "device" (free, on-device) or "cloud" (premium via /api/tts).
# VITE_TTS=device

# Canonical URL used when the app shares a link via the device share sheet
# (src/lib/share.js). Leave blank to fall back to the current page's origin.
# VITE_PUBLIC_URL=https://your-domain.example

# Public Play Store listing URL (used by the in-app "Rate" fallback on web).
# VITE_PLAY_URL=https://play.google.com/store/apps/details?id=com.whiskeracademy.app

# The app links to /privacy and /terms on the same domain by default (served by
# the server). Override only if you host them elsewhere:
# VITE_PRIVACY_URL=/privacy
# VITE_TERMS_URL=/terms

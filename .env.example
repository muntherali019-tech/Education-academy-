# Copy to .env.local and fill in to enable the camera features (photo marking
# and scan & solve) in `npm run dev`. The key is read by the dev-server
# endpoints only — it never reaches the browser.
ANTHROPIC_API_KEY=

# Photos per hour, per client and across the whole deployment. Both endpoints
# share these. Defaults: 20 and 120.
# PHOTO_RATE_LIMIT_PER_CLIENT=20
# PHOTO_RATE_LIMIT_TOTAL=120

# Only needed when the endpoints are not served from this origin.
# VITE_MARKING_ENDPOINT=https://example.com/api/mark
# VITE_SOLVE_ENDPOINT=https://example.com/api/solve

# ---- Production server (npm start / render.yaml) only ----
# Port the built server listens on. Default 3000.
# PORT=3000
# Directory of the built browser bundle it serves. Default "dist".
# STATIC_DIR=dist
# Set to 1 ONLY behind a proxy you control that overwrites x-forwarded-for
# (Render does). Anywhere a client reaches the process directly, leaving this
# off is what stops a caller spoofing the header for a fresh rate allowance.
# TRUST_PROXY=1

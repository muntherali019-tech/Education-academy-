# Web build (your website). Payments go through Stripe Checkout.
VITE_PLATFORM=web
VITE_BILLING=stripe
# No publishable key here on purpose: the server creates the Checkout Session and
# the browser is redirected to Stripe's hosted page, so the frontend never loads
# Stripe.js. The secret key (sk_…) stays server-side — set STRIPE_SECRET_KEY in
# Render or your .env.
